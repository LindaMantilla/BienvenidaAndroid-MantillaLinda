<?xml version="1.0" encoding="utf-8"?>
<!--
    Una sola distribución para todos los tamaños y orientaciones:
    las posiciones se calculan en porcentajes (guías) y no en medidas fijas,
    así el contenido siempre queda en el cielo, por encima del muñeco.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_android">

    <!-- Línea invisible al 10 % de la altura: de ahí cuelga el título. -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guia_superior"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.10" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/boton_idioma"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/margen_borde"
        android:minHeight="48dp"
        android:text="@string/idioma"
        android:textColor="@color/blanco"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:rippleColor="@color/blanco_translucido" />

    <TextView
        android:id="@+id/titulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margen_borde"
        android:gravity="center"
        android:text="@string/bienvenida"
        android:textColor="@color/blanco"
        android:textSize="@dimen/texto_titulo"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/guia_superior" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/boton_entrar"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/separacion_boton"
        android:minWidth="@dimen/ancho_minimo_boton"
        android:minHeight="48dp"
        android:text="@string/entrar"
        android:textColor="@color/blanco"
        android:textSize="@dimen/texto_boton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titulo"
        app:rippleColor="@color/blanco_translucido"
        app:strokeColor="@color/blanco" />

</androidx.constraintlayout.widget.ConstraintLayout>
